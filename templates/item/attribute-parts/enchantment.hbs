{{! Attributes Tab — Enchantment }}
<section
  class="tab attributes {{tab.cssClass}}"
  data-group="primary"
  data-tab="attributes"
>

  <div class="resource">

    <p class="hint">{{localize "REDSTEEL.Enchantment.EditorHint"}}</p>

    <div class="grid grid-3col">
      <div class="grid-span-1">
        <label for="enchantment-slot">{{localize
            "REDSTEEL.Enchantment.FIELDS.slot.label"
          }}</label>
        <select name="system.slot" id="enchantment-slot">
          {{#each system.slotOptions as |slotOption|}}
            <option value="{{slotOption}}"
              {{#if (eq ../system.slot slotOption)}}selected{{/if}}>
              {{localize (concat "REDSTEEL.Enchantment.Slot." slotOption)}}
            </option>
          {{/each}}
        </select>
      </div>

      <div class="grid-span-1">
        <label class="resource-label">{{localize
            "REDSTEEL.Enchantment.FIELDS.tier.label"
          }}</label>
        <input
          type="number"
          name="system.tier"
          value="{{system.tier}}"
          data-dtype="Number"
        />
      </div>

      <div class="grid-span-1">
        <label class="resource-label" title="{{localize
            'REDSTEEL.Enchantment.FIELDS.mindReserve.hint'
          }}">{{localize
            "REDSTEEL.Enchantment.FIELDS.mindReserve.label"
          }}</label>
        <input
          type="number"
          name="system.mindReserve"
          value="{{system.mindReserve}}"
          data-dtype="Number"
          min="0"
        />
      </div>

      {{#if (eq system.slot "weapon")}}
        <div class="grid-span-1">
          <label for="enchantment-required-class" title="{{localize
              'REDSTEEL.Enchantment.FIELDS.requiredClass.hint'
            }}">{{localize
              "REDSTEEL.Enchantment.FIELDS.requiredClass.label"
            }}</label>
          <select name="system.requiredClass" id="enchantment-required-class">
            <option value="" {{#unless system.requiredClass}}selected{{/unless}}>
              {{localize "REDSTEEL.Enchantment.AnyClass"}}
            </option>
            {{#each system.classOptions as |classOption|}}
              <option value="{{classOption}}"
                {{#if (eq ../system.requiredClass classOption)}}selected{{/if}}>
                {{classOption}}
              </option>
            {{/each}}
          </select>
        </div>
      {{/if}}
    </div>

    {{!-- =====================
         ITEMISATION
    ====================== --}}
    <h3 class="enchantment-heading">{{localize
        "REDSTEEL.Enchantment.Itemisation"
      }}</h3>
    <p class="hint">{{localize "REDSTEEL.Enchantment.ItemisationHint"}}</p>

    <div class="grid grid-3col">
      <div class="grid-span-1">
        <label for="enchantment-group">{{localize
            "REDSTEEL.Enchantment.FIELDS.group.label"
          }}</label>
        <select name="system.group" id="enchantment-group">
          <option value="" {{#unless system.group}}selected{{/unless}}>
            {{localize "REDSTEEL.Enchantment.Group.none"}}
          </option>
          {{#each system.groupOptions as |groupOption|}}
            <option value="{{groupOption}}"
              {{#if (eq ../system.group groupOption)}}selected{{/if}}>
              {{localize (concat "REDSTEEL.Enchantment.Group." groupOption)}}
            </option>
          {{/each}}
        </select>
      </div>

      <div class="grid-span-1">
        <label class="resource-label" title="{{localize
            'REDSTEEL.Enchantment.FIELDS.requiredFaith.hint'
          }}">{{localize
            "REDSTEEL.Enchantment.FIELDS.requiredFaith.label"
          }}</label>
        <input
          type="number"
          name="system.requiredFaith"
          value="{{system.requiredFaith}}"
          data-dtype="Number"
          min="0"
        />
      </div>

      <div class="grid-span-1">
        <label class="checkbox" title="{{localize
            'REDSTEEL.Enchantment.FIELDS.bound.hint'
          }}">
          <input
            type="checkbox"
            name="system.bound"
            {{checked system.bound}}
          />
          {{localize "REDSTEEL.Enchantment.FIELDS.bound.label"}}
        </label>
      </div>
    </div>

    {{!-- =====================
         ACTIVATION
    ====================== --}}
    <h3 class="enchantment-heading">{{localize
        "REDSTEEL.Enchantment.Activation"
      }}</h3>

    <div class="grid grid-3col">
      <div class="grid-span-1">
        <label class="checkbox" title="{{localize
            'REDSTEEL.Enchantment.FIELDS.activationEnabled.hint'
          }}">
          <input
            type="checkbox"
            name="system.activation.enabled"
            {{checked system.activation.enabled}}
          />
          {{localize "REDSTEEL.Enchantment.FIELDS.activationEnabled.label"}}
        </label>
      </div>
    </div>

    {{#if system.activation.enabled}}
      <div class="grid grid-3col">
        <div class="grid-span-1">
          <label class="resource-label">{{localize
              "REDSTEEL.Item.Spell.FIELDS.headerActions.label"
            }}</label>
          <input
            type="text"
            placeholder="e.g. 1"
            name="system.activation.actionCost"
            value="{{system.activation.actionCost}}"
            data-dtype="String"
          />
        </div>

        <div class="grid-span-1">
          <label class="resource-label">{{localize
              "REDSTEEL.Item.Spell.FIELDS.headerRange.label"
            }}</label>
          <input
            type="text"
            name="system.activation.range"
            value="{{system.activation.range}}"
            data-dtype="String"
          />
        </div>

        <div class="grid-span-1">
          <label class="resource-label" title="{{localize
              'REDSTEEL.Enchantment.FIELDS.costResource.hint'
            }}">{{localize
              "REDSTEEL.Enchantment.FIELDS.costResource.label"
            }}</label>
          <select name="system.cost.resource">
            <option value="" {{#unless system.cost.resource}}selected{{/unless}}>
              {{localize "REDSTEEL.Enchantment.NoCost"}}
            </option>
            {{#each system.costResourceOptions as |resourceOption|}}
              <option value="{{resourceOption}}"
                {{#if (eq ../system.cost.resource resourceOption)}}selected{{/if}}>
                {{resourceOption}}
              </option>
            {{/each}}
          </select>
        </div>

        {{#if system.cost.resource}}
          <div class="grid-span-1">
            <label class="resource-label">{{localize
                "REDSTEEL.Enchantment.FIELDS.costAmount.label"
              }}</label>
            <input
              type="number"
              name="system.cost.amount"
              value="{{system.cost.amount}}"
              data-dtype="Number"
              min="0"
            />
          </div>
        {{/if}}

        <div class="grid-span-1">
          <label class="resource-label" title="{{localize
              'REDSTEEL.Enchantment.FIELDS.chargesMax.hint'
            }}">{{localize
              "REDSTEEL.Enchantment.FIELDS.chargesMax.label"
            }}</label>
          <input
            type="number"
            name="system.charges.max"
            value="{{system.charges.max}}"
            data-dtype="Number"
            min="0"
          />
        </div>

        {{#if system.charges.max}}
          <div class="grid-span-1">
            <label for="enchantment-recharge" title="{{localize
                'REDSTEEL.Enchantment.FIELDS.recharge.hint'
              }}">{{localize
                "REDSTEEL.Enchantment.FIELDS.recharge.label"
              }}</label>
            <select name="system.charges.recharge" id="enchantment-recharge">
              {{#each system.rechargeOptions as |rechargeOption|}}
                <option value="{{rechargeOption}}"
                  {{#if (eq ../system.charges.recharge rechargeOption)}}selected{{/if}}>
                  {{#if rechargeOption}}
                    {{localize (concat "REDSTEEL.Enchantment.Recharge." rechargeOption)}}
                  {{else}}
                    {{localize "REDSTEEL.Enchantment.Recharge.none"}}
                  {{/if}}
                </option>
              {{/each}}
            </select>
          </div>
        {{/if}}

        <div class="grid-span-1">
          <label for="enchantment-risk-test" title="{{localize
              'REDSTEEL.Enchantment.FIELDS.riskTest.hint'
            }}">{{localize
              "REDSTEEL.Enchantment.FIELDS.riskTest.label"
            }}</label>
          <select name="system.risk.test" id="enchantment-risk-test">
            {{#each system.riskTestOptions as |testOption|}}
              <option value="{{testOption}}"
                {{#if (eq ../system.risk.test testOption)}}selected{{/if}}>
                {{#if testOption}}
                  {{localize (concat "REDSTEEL.Enchantment.RiskTest." testOption)}}
                {{else}}
                  {{localize "REDSTEEL.Enchantment.RiskTest.none"}}
                {{/if}}
              </option>
            {{/each}}
          </select>
        </div>

        {{#if (eq system.risk.test "resolve")}}
          <div class="grid-span-1">
            <label class="resource-label" title="{{localize
                'REDSTEEL.Enchantment.FIELDS.riskInsanity.hint'
              }}">{{localize
                "REDSTEEL.Enchantment.FIELDS.riskInsanity.label"
              }}</label>
            <input
              type="number"
              name="system.risk.insanity"
              value="{{system.risk.insanity}}"
              data-dtype="Number"
              min="0"
            />
          </div>
        {{/if}}

        {{#if (eq system.group "mind_reserved")}}
          <div class="grid-span-1">
            <label class="resource-label" title="{{localize
                'REDSTEEL.Enchantment.FIELDS.pursuitChance.hint'
              }}">{{localize
                "REDSTEEL.Enchantment.FIELDS.pursuitChance.label"
              }}</label>
            <input
              type="number"
              name="system.risk.pursuitChance"
              value="{{system.risk.pursuitChance}}"
              data-dtype="Number"
              min="0"
              max="100"
            />
          </div>
        {{/if}}
      </div>

      <div class="form-group stacked">
        <label>{{localize
            "REDSTEEL.Enchantment.FIELDS.useEffects.label"
          }}</label>
        <input
          type="text"
          name="system.activation.useEffectsRaw"
          value="{{system.activation.useEffectsRaw}}"
          placeholder="e.g. ice_weapon, guard"
        />
        <p class="hint">{{localize
            "REDSTEEL.Enchantment.FIELDS.useEffects.hint"
          }}</p>
      </div>

      {{#if (eq system.group "insanity_risk")}}
        <div class="form-group stacked">
          <label>{{localize
              "REDSTEEL.Enchantment.FIELDS.safeEffects.label"
            }}</label>
          <input
            type="text"
            name="system.activation.safeEffectsRaw"
            value="{{system.activation.safeEffectsRaw}}"
            placeholder="e.g. guard"
          />
          <p class="hint">{{localize
              "REDSTEEL.Enchantment.FIELDS.safeEffects.hint"
            }}</p>
        </div>
      {{/if}}

      <div class="form-group stacked">
        <label>{{localize
            "REDSTEEL.Enchantment.FIELDS.activationSummary.label"
          }}</label>
        <input
          type="text"
          name="system.activation.summary"
          value="{{system.activation.summary}}"
          placeholder="{{localize
            'REDSTEEL.Enchantment.FIELDS.activationSummary.hint'
          }}"
        />
      </div>
    {{/if}}

    {{!-- =====================
         WEAPON MODIFIERS
    ====================== --}}
    {{#if (eq system.slot "weapon")}}
      <h3 class="enchantment-heading">{{localize
          "REDSTEEL.Enchantment.WeaponMods"
        }}</h3>

      <div class="grid grid-4col">
        <div class="grid-span-1">
          <label class="resource-label">{{localize
              "REDSTEEL.Item.Weapon.FIELDS.attack.label"
            }}</label>
          <input
            type="number"
            name="system.weaponMods.attack"
            value="{{system.weaponMods.attack}}"
            data-dtype="Number"
          />
        </div>

        <div class="grid-span-1">
          <label class="resource-label">{{localize
              "REDSTEEL.Item.Weapon.FIELDS.defense.label"
            }}</label>
          <input
            type="number"
            name="system.weaponMods.defense"
            value="{{system.weaponMods.defense}}"
            data-dtype="Number"
          />
        </div>

        <div class="grid-span-1">
          <label class="resource-label">{{localize
              "REDSTEEL.Item.Weapon.FIELDS.dodge.label"
            }}</label>
          <input
            type="number"
            name="system.weaponMods.dodge"
            value="{{system.weaponMods.dodge}}"
            data-dtype="Number"
          />
        </div>

        <div class="grid-span-1">
          <label class="resource-label">{{localize
              "REDSTEEL.Item.Weapon.FIELDS.penetration.label"
            }}</label>
          <input
            type="number"
            name="system.weaponMods.penetration"
            value="{{system.weaponMods.penetration}}"
            data-dtype="Number"
          />
        </div>

        <div class="grid-span-1">
          <label class="resource-label">{{localize
              "REDSTEEL.Enchantment.FIELDS.damageBonus.label"
            }}</label>
          <input
            type="number"
            name="system.weaponMods.damageBonus"
            value="{{system.weaponMods.damageBonus}}"
            data-dtype="Number"
          />
        </div>

        <div class="grid-span-1">
          <label class="resource-label" title="{{localize
              'REDSTEEL.Enchantment.FIELDS.damageRoll.hint'
            }}">{{localize
              "REDSTEEL.Enchantment.FIELDS.damageRoll.label"
            }}</label>
          <input
            type="text"
            name="system.weaponMods.damageRoll"
            value="{{system.weaponMods.damageRoll}}"
            data-dtype="String"
            placeholder="e.g. 1d4"
          />
        </div>

        <div class="grid-span-1">
          <label class="resource-label" title="{{localize
              'REDSTEEL.Enchantment.FIELDS.breakthroughRoll.hint'
            }}">{{localize
              "REDSTEEL.Enchantment.FIELDS.breakthroughRoll.label"
            }}</label>
          <input
            type="text"
            name="system.weaponMods.breakthroughRoll"
            value="{{system.weaponMods.breakthroughRoll}}"
            data-dtype="String"
            placeholder="e.g. 2d6"
          />
        </div>

        <div class="grid-span-1">
          <label class="resource-label">{{localize
              "REDSTEEL.Item.Weapon.FIELDS.critRange.label"
            }}</label>
          <input
            type="number"
            name="system.weaponMods.critRange"
            value="{{system.weaponMods.critRange}}"
            data-dtype="Number"
          />
        </div>

        <div class="grid-span-1">
          <label class="resource-label">{{localize
              "REDSTEEL.Item.Weapon.FIELDS.critChance.label"
            }}</label>
          <input
            type="number"
            name="system.weaponMods.critChance"
            value="{{system.weaponMods.critChance}}"
            data-dtype="Number"
          />
        </div>

        <div class="grid-span-1">
          <label class="resource-label">{{localize
              "REDSTEEL.Item.Weapon.FIELDS.critDefense.label"
            }}</label>
          <input
            type="number"
            name="system.weaponMods.critDefense"
            value="{{system.weaponMods.critDefense}}"
            data-dtype="Number"
          />
        </div>

        <div class="grid-span-1">
          <label class="resource-label">{{localize
              "REDSTEEL.Item.Weapon.FIELDS.critDamage.label"
            }}</label>
          <input
            type="number"
            name="system.weaponMods.critDamage"
            value="{{system.weaponMods.critDamage}}"
            data-dtype="Number"
          />
        </div>

        <div class="grid-span-1">
          <label for="enchantment-damage-type-mode" title="{{localize
              'REDSTEEL.Enchantment.FIELDS.damageTypeMode.hint'
            }}">{{localize
              "REDSTEEL.Enchantment.FIELDS.damageTypeMode.label"
            }}</label>
          <select
            name="system.weaponMods.damageTypeMode"
            id="enchantment-damage-type-mode"
          >
            {{#each system.damageTypeModeOptions as |mode|}}
              <option value="{{mode}}"
                {{#if (eq ../system.weaponMods.damageTypeMode mode)}}selected{{/if}}>
                {{#if mode}}
                  {{localize (concat "REDSTEEL.Enchantment.DamageTypeMode." mode)}}
                {{else}}
                  {{localize "REDSTEEL.Enchantment.DamageTypeMode.none"}}
                {{/if}}
              </option>
            {{/each}}
          </select>
        </div>
      </div>

      <h3 class="enchantment-heading">{{localize
          "REDSTEEL.Enchantment.FIELDS.damageTypes.label"
        }}</h3>
      <p class="hint">{{localize
          "REDSTEEL.Enchantment.FIELDS.damageTypes.hint"
        }}</p>

      <div class="grid grid-3col">
        {{#each enchantDamageTypeSlots as |slot|}}
          <div class="grid-span-1">
            <select name="system.weaponMods.damageTypes.{{slot.index}}">
              <option value="">{{localize "REDSTEEL.UI.selectType"}}</option>
              {{#each @root.system.dmgTypes as |dmgType|}}
                <option value="{{dmgType}}"
                  {{#if (eq slot.value dmgType)}}selected{{/if}}>
                  {{dmgType}}
                </option>
              {{/each}}
            </select>
          </div>
        {{/each}}
      </div>
    {{/if}}

    {{!-- =====================
         GEAR MODIFIERS
    ====================== --}}
    {{#if (eq system.slot "gear")}}
      <h3 class="enchantment-heading">{{localize
          "REDSTEEL.Enchantment.GearMods"
        }}</h3>

      <div class="grid grid-4col">
        <div class="grid-span-1">
          <label class="resource-label">{{localize
              "REDSTEEL.Enchantment.FIELDS.armorValue.label"
            }}</label>
          <input
            type="number"
            name="system.gearMods.armorValue"
            value="{{system.gearMods.armorValue}}"
            data-dtype="Number"
          />
        </div>

        <div class="grid-span-1">
          <label class="resource-label">{{localize
              "REDSTEEL.Item.Gear.FIELDS.defense.label"
            }}</label>
          <input
            type="number"
            name="system.gearMods.defense"
            value="{{system.gearMods.defense}}"
            data-dtype="Number"
          />
        </div>

        <div class="grid-span-1">
          <label class="resource-label">{{localize
              "REDSTEEL.Item.Gear.FIELDS.rangedDefense.label"
            }}</label>
          <input
            type="number"
            name="system.gearMods.rangedDefense"
            value="{{system.gearMods.rangedDefense}}"
            data-dtype="Number"
          />
        </div>

        <div class="grid-span-1">
          <label class="resource-label">{{localize
              "REDSTEEL.Item.Gear.FIELDS.healthBonus.label"
            }}</label>
          <input
            type="number"
            name="system.gearMods.healthBonus"
            value="{{system.gearMods.healthBonus}}"
            data-dtype="Number"
          />
        </div>

        <div class="grid-span-1">
          <label class="resource-label">{{localize
              "REDSTEEL.Item.Gear.FIELDS.critDefense.label"
            }}</label>
          <input
            type="number"
            name="system.gearMods.critDefense"
            value="{{system.gearMods.critDefense}}"
            data-dtype="Number"
          />
        </div>

        <div class="grid-span-1">
          <label class="resource-label">{{localize
              "REDSTEEL.Item.Gear.FIELDS.rangedCritDefense.label"
            }}</label>
          <input
            type="number"
            name="system.gearMods.rangedCritDefense"
            value="{{system.gearMods.rangedCritDefense}}"
            data-dtype="Number"
          />
        </div>
      </div>

      <h3 class="enchantment-heading">{{localize
          "REDSTEEL.Enchantment.FIELDS.resist.label"
        }}</h3>

      <div class="grid grid-8col">
        {{#each system.gearMods.resist as |value key|}}
          <div class="grid-span-1">
            <label>
              {{localize (concat "REDSTEEL.Item.Gear.FIELDS." key ".label")}}
            </label>
            <input
              type="number"
              name="system.gearMods.resist.{{key}}"
              value="{{value}}"
              data-dtype="Number"
            />
          </div>
        {{/each}}
      </div>
    {{/if}}

  </div>
</section>
